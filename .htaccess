# Security headers. The host already sends the usual ones (nosniff, SAMEORIGIN framing, Referrer-Policy, HTTPS only),
# so only what it doesn't send is added here
<IfModule mod_headers.c>
  # these pages never need the camera, microphone or location
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
